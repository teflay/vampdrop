{
  "version": 2,
  "builds": [{ "src": "public/**", "use": "@vercel/static" }],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://vamp.alwaysdata.net/api/$1" },
    { "src": "/f/(.*)", "dest": "/public/index.html" },
    { "src": "/delete/(.*)", "dest": "/public/index.html" },
    { "src": "/admin", "dest": "/public/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}